{
  "expo": {
    "name": "Al-Ghazaly Dining",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alghazalyparts",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alghazalyparts.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Upload product photos and images",
        "NSPhotoLibraryUsageDescription": "Select images for product listings",
        "NSPhotoLibraryAddUsageDescription": "Save product images to your device",
        "NSLocationWhenInUseUsageDescription": "Find nearby restaurants for dining and delivery",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.alghazalyparts.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#000000",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Al-Ghazaly to access your photos for product images",
          "cameraPermission": "Allow Al-Ghazaly to access camera for product photos"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
